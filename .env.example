# Copy this file to .env.local and fill in your Supabase project details.
# Find these in Supabase Dashboard -> Project Settings -> API.
# Only the anon/public key goes here — never the service_role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Set to "true" to force demo mode (synthetic data, no Supabase calls) e.g. for the public showcase deployment.
VITE_DEMO_MODE=false
